{
  "id": "simian",
  "name": "SIMIAN",
  "abbrev": "SMN",
  "version": "0.1.0",
  "author": "legsmechanical",
  "license": "GPL-3.0-or-later",
  "description": "OneTrick SIMIAN 2 by Punk Labs, ported to Schwung: a ten-voice drum synthesiser with no samples in it. Each voice is a triangle-to-cymbal oscillator and a resonant-lowpass noise source crossfaded under one decay envelope, with a click transient, per-voice saturation, and a shared Zita reverb. 35 factory kits, per-voice Send A/B into the host's return buses, and every voice renderable onto its own bus.",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": false,
    "chainable": true,
    "component_type": "sound_generator",
